<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.WRITE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

        <queries>
        <package android:name="com.nijatva.messages" />
        <package android:name="com.nijatva.contacts" />
        <package android:name="com.nijatva.dialer" />
        <package android:name="com.nijatva.file" />
        <package android:name="com.nijatva.gallery" />
        <package android:name="com.nijatva.camera" />
        <package android:name="com.nijatva.music.player" />
        <package android:name="in.nijatva.browser" />
        <package android:name="com.nijatva.drive" />
            <package android:name="com.nijatva.photos" />
        <package android:name="com.nijatva.photo.editor" />
        <package android:name="com.nijatva.videoplayer" />
        <package android:name="com.nijatva.mini.x" />
        <package android:name="com.nijatva.wtrlab" />
    </queries>
<application android:label="@string/app_name" android:icon="@drawable/ic_launcher" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ThreadActivity" android:exported="false" />

        <!-- The Nijatva signature, shared with every app in the suite -->
        <activity
            android:name="com.nijatva.signature.SignatureAppearanceActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity
            android:name="com.nijatva.signature.SignatureDeveloperActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".ComposeActivity" android:exported="false" />

        <activity android:name=".SendToActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <receiver android:name=".SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver android:name=".MmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service android:name=".HeadlessSmsService" android:exported="true" android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
            <!-- Nijatva signature: who made this build, for anyone who inspects the APK -->
        <meta-data android:name="developer.name" android:value="Vasudev Dangaya" />
        <meta-data android:name="developer.origin" android:value="India" />
        <meta-data android:name="developer.site" android:value="https://vasudev-work.github.io" />
        <meta-data android:name="nijatva.suite" android:value="Nijatva" />
        <meta-data android:name="nijatva.signature" android:value="com.nijatva.signature" />

</application>
</manifest>